# The measurement harness stays local. Its numbers are specific to one caller's
# resident context and one quota pair, and publishing a corpus invites people to
# quote a ratio that was never theirs.
benchmark/

# Agent memory and per-machine settings. Public repo, and settings.json holds
# an absolute autoMemoryDirectory that is true on one laptop only. Dropbox
# still syncs both. Not .claude-plugin/, which is the published plugin manifest.
.claude/
